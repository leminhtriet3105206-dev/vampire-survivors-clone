# ─────────────────────────────────────────────────────────────
#  Legendary Survival - backend environment variables
#  Copy this file to ".env" (same folder) and adjust the values.
# ─────────────────────────────────────────────────────────────

# "development" or "production"
NODE_ENV=development

# HTTP port (the frontend is served from the same port)
PORT=3000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/legendary_survival

# Secret used to sign JWTs. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# How long a login session stays valid (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-14 is reasonable)
BCRYPT_ROUNDS=12

# Comma-separated list of allowed origins when the frontend is hosted
# on a DIFFERENT domain/port. Leave empty when using the built-in static server.
CLIENT_ORIGIN=

# Starting balance given to newly registered players
STARTING_GOLD=1500
STARTING_DIAMONDS=60
STARTING_RUBIES=10

